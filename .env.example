VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google Analytics 4 ──────────────────────────────────
# Get from: analytics.google.com → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX)
VITE_GA_ID=

VITE_SENTRY_DSN=

# ── Microsoft Clarity (heatmaps + session recordings) ────
# Get from: clarity.microsoft.com → project → Settings → Setup → Installation
VITE_CLARITY_ID=

# ── Google Search Console ────────────────────────────────
# Get from: search.google.com/search-console → Add property → HTML tag → content value
VITE_GSC_TOKEN=

# ── OpenWeatherMap (IoT Dashboard) ───────────────────────
# Free tier: openweathermap.org/api → My API Keys (60 calls/min free)
VITE_OWM_KEY=

# ── WhatsApp Business API ────────────────────────────────
# Get from: developers.facebook.com → your app → WhatsApp → API Setup
# SECURITY: These go into Supabase Edge Function secrets — NOT VITE_ prefixed
# (browser never sees them — only the edge function does)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=             # permanent token from System User (not the 24h temp one)
WA_RECIPIENT_NUMBER=         # your admin WhatsApp number for order alerts

# ── SteadFast Courier ────────────────────────────────────
# Get from: portal.steadfast.com.bd → API → Generate Key
# SECURITY: These go into Supabase Edge Function secrets — NOT VITE_ prefixed
# (browser never sees them — only the steadfast-create-shipment edge function does)
STEADFAST_KEY=
STEADFAST_SECRET=
